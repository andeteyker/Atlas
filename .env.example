# ATLAS Swarm — Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein:
# cp .env.example .env

# ── API-Zugang (OpenRouter) ───────────────────────────────────────────────────
# OpenRouter-Account: https://openrouter.ai
# API-Key erstellen: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-DEIN_KEY_HIER

# OpenRouter Base URL (Standard, nicht ändern)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Modell-Auswahl ────────────────────────────────────────────────────────────
# Überschreibt das Default-Modell aus atlas_config/models.yaml
# Empfehlungen:
#   minimax/minimax-m2.5          — Standard (gute Balance)
#   anthropic/claude-3-haiku      — Schnell und günstig
#   anthropic/claude-3.5-sonnet   — Beste Qualität
#   google/gemini-flash-1.5       — Schnell + multimodal
#   mistralai/mistral-7b-instruct — Open-Source Option
# ATLAS_DEFAULT_MODEL=minimax/minimax-m2.5

# ── Schwarm-Verhalten ─────────────────────────────────────────────────────────
# Spawn-Bestätigung: "true" = Nachfragen vor Agent-Spawn, "false" = Auto-Spawn
ATLAS_SPAWN_CONFIRM=true

# Auto-Lernen: "true" = Nach jedem Lauf automatisch Regeln destillieren
ATLAS_LEARN_AUTO=true

# ── Logging ───────────────────────────────────────────────────────────────────
# "DEBUG" für detaillierte Ausgaben, "INFO" für Standard
# ATLAS_LOG_LEVEL=INFO
